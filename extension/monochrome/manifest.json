{
  "format": "archivetune.module",
  "formatVersion": 1,
  "apiVersion": 1,
  "entry": "provider.js",
  "module": {
    "id": "community.provider.monochrome",
    "name": "Monochrome",
    "displayName": "Monochrome (Lossless & Hi-Fi)",
    "icon": "icon.png",
    "version": "1.0.1",
    "author": "Viscousity",
    "description": "High-fidelity audio stream provider. Swaps lossy YouTube streams with bit-perfect 320kbps CD audio or studio master FLAC on-the-fly without requiring any subscription or account.",
    "homepage": "https://github.com/Viscousity/archivetune-modules",
    "repository": "https://github.com/Viscousity/archivetune-modules",
    "license": "GPL-3.0",
    "type": ["audio_provider"],
    "requiredRuntimeFeatures": ["fetch@1", "settings@1", "streamResolution@1", "qualityOptions@1"],
    "labels": ["FLAC", "Hi-Res", "Lossless", "Hi-Fi", "Free"],
    "capabilities": ["searchTracks", "getTrackStreamUrl"],
    "settings": {
      "customResolver": {
        "type": "text",
        "label": "Custom Lossless Resolver (Optional)",
        "description": "Custom Tidal/Qobuz/Monochrome server endpoint. If left blank, uses the high-speed direct bit-perfect stream pipeline.",
        "defaultValue": ""
      }
    },
    "qualityLabel": "Audio quality",
    "defaultQuality": "lossless",
    "qualityOptions": [
      {
        "id": "lossless",
        "label": "High-Fidelity / CD Quality (320 kbps / FLAC)",
        "description": "Bit-perfect high-fidelity stream resolution.",
        "kind": "lossless"
      },
      {
        "id": "low",
        "label": "Standard Quality (96 kbps)",
        "description": "Data saver stream format.",
        "kind": "standard"
      }
    ]
  }
}
