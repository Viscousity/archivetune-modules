{
  "format": "archivetune.module",
  "formatVersion": 1,
  "apiVersion": 1,
  "entry": "provider.js",
  "module": {
    "id": "community.provider.monochrome",
    "name": "Monochrome",
    "displayName": "Monochrome (Hi-Fi Streamer)",
    "icon": "icon.png",
    "version": "1.0.3",
    "author": "Viscousity",
    "description": "High-fidelity audio stream provider. Delivers authentic 320 kbps AAC progressive streams and supports custom self-hosted FLAC endpoints without spoofed metadata.",
    "homepage": "https://github.com/Viscousity/archivetune-modules",
    "repository": "https://github.com/Viscousity/archivetune-modules",
    "license": "GPL-3.0",
    "type": ["audio_provider"],
    "requiredRuntimeFeatures": ["fetch@1", "settings@1", "streamResolution@1", "qualityOptions@1"],
    "labels": ["320kbps", "AAC", "Hi-Fi", "Free"],
    "capabilities": ["searchTracks", "getTrackStreamUrl"],
    "settings": {
      "customResolver": {
        "type": "text",
        "label": "Custom Lossless Resolver (Optional)",
        "description": "URL to a self-hosted Tidal/Qobuz/Lucida proxy. If left blank, uses the high-speed 320 kbps direct engine.",
        "defaultValue": ""
      }
    },
    "qualityLabel": "Audio quality",
    "defaultQuality": "HIGH_320",
    "qualityOptions": [
      {
        "id": "HIGH_320",
        "label": "High · 320 kbps AAC",
        "description": "High-fidelity progressive stream at 320 kbps.",
        "kind": "lossy"
      },
      {
        "id": "LOW_96",
        "label": "Data saver · 96 kbps AAC",
        "description": "Data saver stream format.",
        "kind": "lossy"
      }
    ]
  }
}
